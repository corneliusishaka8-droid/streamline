# HTTP port used by the Express API.
PORT=3000

# Frontend origin allowed to use the session cookie.
FRONTEND_URL=http://localhost:5173

# Replace this with a long random value before deploying.
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL connection string for a local or hosted database.
DATABASE_URL="postgresql://postgres:1234@localhost:5432/movie_app"

# Google OAuth client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Enable TLS if your PostgreSQL provider requires it.
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true

